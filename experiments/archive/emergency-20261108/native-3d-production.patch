diff --git a/scripts/native-3d/arena.mjs b/scripts/native-3d/arena.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b21e4c35c4fd0dda184547e8291da092d3b1ecb5
--- /dev/null
+++ b/scripts/native-3d/arena.mjs
@@ -0,0 +1,72 @@
+import {readFileSync,writeFileSync,mkdirSync,existsSync} from 'node:fs';
+import {resolve,dirname,join} from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {createHash} from 'node:crypto';
+
+const toolRoot=process.env.MILIASTRA_MCP_ROOT||'D:/MiliastraTools/genshin-miliastra-mcp';
+const load=name=>import(pathToFileURL(join(toolRoot,'src',name)));
+const digest=bytes=>createHash('sha256').update(bytes).digest('hex');
+export const officialArena=JSON.parse(readFileSync(new URL('./arena-scene.json',import.meta.url),'utf8'));
+
+// Copy the complete authored static composition, never the tutorial gameplay.
+// A whole-scene transform preserves relative placement, scale and silhouette.
+// Optional cutaway removes only the near facade for the fixed combat camera.
+export async function installOfficialArena({mapPath,outputPath,sourcePath=join(toolRoot,officialArena.source),offset=officialArena.profiles.combatCamera.offset,yaw=180,cutaway=true}={}){
+  if(!mapPath||!outputPath||resolve(mapPath)===resolve(outputPath)||resolve(sourcePath)===resolve(outputPath))throw Error('Arena requires a distinct output copy');
+  if(![0,180].includes(yaw)||!Array.isArray(offset)||offset.length!==3||!offset.every(Number.isFinite))throw Error('Arena transform requires yaw 0/180 and a finite offset');
+  if(existsSync(outputPath))throw Error('Refuse to overwrite an existing arena candidate');
+  const {container,fields,field,one,replace,wrap,varint}=await load('scene/wire.mjs');
+  const {listSceneEntities}=await load('scene-save.mjs');
+  const sourceBytes=readFileSync(sourcePath),sourceRoot=container(sourceBytes),baseBytes=readFileSync(mapPath);
+  if(digest(sourceBytes)!==officialArena.sourceSha256)throw Error('Official arena source hash differs from the reviewed tutorial');
+  if(listSceneEntities({mapPath,namePrefix:'ABYSS_ARENA_',limit:1}).total)throw Error('Arena is already installed; use the clean input copy');
+  let root=container(baseBytes);
+  const original=listSceneEntities({mapPath:sourcePath,limit:1000}).entities.filter(e=>e.kind==='static');
+  if(original.length!==93)throw Error('Official signal terrain identity changed: expected 93 static entities');
+  const byId=new Map(original.map(e=>[e.guid,e]));
+  const kind=b=>Number(fields(b).find(f=>f.id===1&&f.wire===0)?.value??0);
+  const f32=n=>{const b=Buffer.alloc(4);b.writeFloatLE(n);return b;};
+  const vector=v=>Buffer.concat(v.map((n,i)=>field(i+1,5,f32(n))));
+  const readVector=b=>[1,2,3].map(id=>fields(b).find(f=>f.id===id&&f.wire===5)?.data.readFloatLE(0)??0);
+  const sign=yaw===180?-1:1,entities=[],excluded=[];let next=1079000000;
+  for(const record of fields(one(sourceRoot,5))){
+    if(record.id!==1||record.wire!==2)continue;
+    const oldId=Number(one(record.data,1,0)),meta=byId.get(oldId);if(!meta)continue;
+    const world=meta.position.map((n,i)=>(i===1?n:sign*n)+offset[i]);
+    if(cutaway&&world[2]<officialArena.profiles.combatCamera.nearFacadeZ&&world[1]>-1.5){excluded.push({sourceGuid:oldId,name:meta.name,reason:'camera-facing facade cutaway'});continue;}
+    // No imported server graphs, custom variables, UI or gameplay configurations.
+    const graph=fields(record.data).find(f=>f.id===6&&kind(f.data)===3);
+    if(graph&&one(graph.data,13).length)throw Error('Static scenery unexpectedly contains a graph binding');
+    while(root.includes(varint(next))||entities.some(e=>e.guid===next))next++;
+    if(next>=1082130432)throw Error('No free static entity IDs');
+    const guid=next++,name=`ABYSS_ARENA_${guid}_${meta.name}`;
+    let data=replace(record.data,1,0,guid);
+    data=Buffer.concat(fields(data).map(f=>{
+      if(f.id===5&&kind(f.data)===1){const p=one(f.data,11);return field(5,2,replace(f.data,11,2,replace(p,1,2,Buffer.from(name))));}
+      if(f.id===6&&kind(f.data)===1){let t=one(f.data,11);t=replace(t,1,2,vector(world));
+        const rotation=readVector(one(t,2));rotation[1]+=yaw;t=replace(t,2,2,vector(rotation));
+        return field(6,2,replace(f.data,11,2,t));}
+      return f.raw;
+    }));
+    entities.push({guid,sourceGuid:oldId,name,assetId:meta.assetId,position:world,data});
+  }
+  root=replace(root,5,2,Buffer.concat([one(root,5),...entities.map(e=>field(1,2,e.data))]));
+  const library=one(root,6);let found=false;
+  const listing=entities.map(e=>field(5,2,Buffer.concat([field(1,0,200),field(2,0,e.guid)])));
+  const tabs=fields(library).map(tab=>{
+    if(tab.id!==1||tab.wire!==2||kind(tab.data)!==3)return tab.raw;
+    found=true;const body=one(tab.data,3);return field(1,2,replace(tab.data,3,2,Buffer.concat([body,...listing])));
+  });
+  if(!found)throw Error('Target save has no placed-entity library tab');
+  root=replace(root,6,2,Buffer.concat(tabs));
+  const output=wrap(baseBytes,root);mkdirSync(dirname(resolve(outputPath)),{recursive:true});writeFileSync(outputPath,output,{flag:'wx'});
+  const readback=listSceneEntities({mapPath:outputPath,namePrefix:'ABYSS_ARENA_',limit:1000}).entities;
+  if(readback.length!==entities.length||!entities.every(e=>readback.some(r=>r.guid===e.guid&&r.assetId===e.assetId)))throw Error('Arena entity readback mismatch');
+  return {mapPath:resolve(outputPath),source:{...officialArena,path:resolve(sourcePath),sha256:digest(sourceBytes)},
+    inputSha256:digest(baseBytes),outputSha256:digest(output),sourceStaticCount:original.length,
+    entities:entities.map(({data,...e})=>e),excluded,transform:{offset,yaw,cutaway},
+    evidence:{staticReadback:'passed',officialImport:'not_run',cameraComposition:'requires_current_client_capture',phone:'not_run'},
+    cameraRecommendation:{distance:18,fieldOfView:55,fixedView:{yaw:0,pitch:22}},
+    contactPlatform:officialArena.contactPlatform,
+    note:'Official authored ruin composition; native scene builder must set addFloor:false. Combat placement uses the original flat arrival platform; contactPlatform records its model/scale/collision evidence. Actual standing height and camera visibility require client verification.'};
+}
diff --git a/scripts/native-3d/arena.test.mjs b/scripts/native-3d/arena.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..246ee521639af3afb9a36959eb1a3a98030b686e
--- /dev/null
+++ b/scripts/native-3d/arena.test.mjs
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync,mkdtempSync,existsSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join,resolve} from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {installOfficialArena,officialArena} from './arena.mjs';
+const root=process.env.MILIASTRA_MCP_ROOT||'D:/MiliastraTools/genshin-miliastra-mcp';
+const base=resolve('.artifacts/native-3d-base/base.gil'),source=join(root,officialArena.source);
+test('arena rejects aliasing and unsupported transform before writing',async()=>{
+ await assert.rejects(installOfficialArena({mapPath:'same.gil',outputPath:'same.gil'}),/distinct output/);
+ await assert.rejects(installOfficialArena({mapPath:'a.gil',outputPath:'b.gil',yaw:90}),/yaw/);
+});
+test('official authored scenery is copied without changing rules, cameras or UI',{skip:!existsSync(base)||!existsSync(source)},async()=>{
+ const {container,fields,one}=await import(pathToFileURL(join(root,'src/scene/wire.mjs')));
+ const {listSceneEntities}=await import(pathToFileURL(join(root,'src/scene-save.mjs')));
+ const input=readFileSync(base),original=container(input),directory=mkdtempSync(join(tmpdir(),'abyss-official-arena-'));
+ const target=join(directory,'ruins.gil');
+ const receipt=await installOfficialArena({mapPath:base,outputPath:target});
+ assert.deepEqual(readFileSync(base),input);
+ assert.equal(receipt.sourceStaticCount,93);assert.equal(receipt.entities.length,91);assert.equal(receipt.excluded.length,2);
+ assert.equal(receipt.evidence.officialImport,'not_run');
+ const output=container(readFileSync(target));
+ assert.deepEqual(fields(original).filter(f=>![5,6].includes(f.id)).map(f=>f.raw),fields(output).filter(f=>![5,6].includes(f.id)).map(f=>f.raw));
+ const before=fields(one(original,5)).map(f=>f.raw),after=fields(one(output,5)).slice(0,before.length).map(f=>f.raw);
+ assert.deepEqual(after,before,'every preexisting entity remains byte-identical');
+ const ids=listSceneEntities({mapPath:target,limit:1000}).entities.map(e=>e.guid);
+ assert.equal(new Set(ids).size,ids.length);
+ for(const entity of receipt.entities){
+  assert.ok(entity.assetId<30000000,'only scenery, no teaching enemies');
+  assert.ok(entity.name.startsWith('ABYSS_ARENA_'));
+ }
+ await assert.rejects(installOfficialArena({mapPath:base,outputPath:target}),/overwrite/);
+ await assert.rejects(installOfficialArena({mapPath:target,outputPath:join(directory,'duplicate.gil')}),/already installed/);
+ assert.equal(existsSync(join(directory,'duplicate.gil')),false);
+});
+test('uncut profile preserves all 93 authored scenery pieces',{skip:!existsSync(base)||!existsSync(source)},async()=>{
+ const target=join(mkdtempSync(join(tmpdir(),'abyss-official-arena-full-')),'ruins.gil');
+ const receipt=await installOfficialArena({mapPath:base,outputPath:target,cutaway:false,yaw:0,offset:[0,0,0]});
+ assert.equal(receipt.entities.length,93);assert.equal(receipt.excluded.length,0);
+ const {listSceneEntities}=await import(pathToFileURL(join(root,'src/scene-save.mjs')));
+ const original=new Map(listSceneEntities({mapPath:source,limit:1000}).entities.map(e=>[e.guid,e]));
+ for(const e of receipt.entities)assert.deepEqual(e.position,original.get(e.sourceGuid).position.map(n=>n+0));
+});
diff --git a/scripts/native-3d/camera-projection.mjs b/scripts/native-3d/camera-projection.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9c25aa7c4983b08a3168731e4564cbf93f887dbf
--- /dev/null
+++ b/scripts/native-3d/camera-projection.mjs
@@ -0,0 +1,77 @@
+import {readFileSync,writeFileSync,copyFileSync,mkdirSync,constants} from 'node:fs';
+import {resolve,dirname,join} from 'node:path';
+import {randomUUID,createHash} from 'node:crypto';
+import {assertGraphBudget,assertCompiledBudget} from './graph-budget.mjs';
+
+const head="import {g,defineSignal} from 'genshin-ts/runtime/core'\n";
+const sample="const SAMPLE=defineSignal('LAB3D_CAMERA_SAMPLE',[['seq','int'],['point','int'],['x','float'],['y','float'],['z','float']] as const);\n";
+const payload=[{name:'seq',type:'integer'},{name:'point',type:'integer'},...['x','y','z'].map(name=>({name,type:'float'}))];
+export const cameraProjectionPoints=Object.freeze([[.5,.5,1],[.5,.5,2],[.6,.5,1],[.5,.6,1]].map(Object.freeze));
+export function cameraProjectionSources({server,skill,skillId}){
+ const client=head+sample+`g.characterSkill({id:${skill.graphId},name:${JSON.stringify(skill.name)},prefix:false}).on('start',(_evt,f)=>{
+ const unit=f.getSelfEntity(),seq=f.getCustomVariable(unit,'LAB_camera_seq').asType('int');
+ ${cameraProjectionPoints.map(([u,v,depth],i)=>`const screen${i}=f.viewportCoordinatesToScreenCoordinates(${u},${v});
+ const world${i}=f.screenCoordinatesToWorldCoordinates(screen${i}.screenX,screen${i}.screenY,${depth});
+ const xyz${i}=f.split3dVector(world${i});
+ f.sendSignalToServerNodeGraph(SAMPLE,seq,${i}n,xyz${i}.xComponent,xyz${i}.yComponent,xyz${i}.zComponent);`).join('\n')}
+ })`;
+ const code=head+sample+"import {CharacterSkillSlot,TopOfStackSkillDestructionType} from 'genshin-ts/definitions/enum'\n"+
+ "const REQUEST=defineSignal('LAB3D_CAMERA_REQUEST',[['seq','int']] as const);\n"+
+ "const CAMERA=defineSignal('client:LAB3D_CAMERA',[['player','entity'],['seq','int'],['point','int'],['x','float'],['y','float'],['z','float']] as const);\n"+
+ `g.server({id:${server.graphId},name:${JSON.stringify(server.name)}})
+ .on('whenEntityIsCreated',(evt,f)=>{
+ f.addCharacterSkill(evt.eventSourceEntity as any,${skillId},CharacterSkillSlot.Skill2Q,TopOfStackSkillDestructionType.Destroy);
+ })
+ .onSignal(REQUEST,(evt,f)=>{
+ if(evt.params.seq<=0n)return;
+ const players=f.getListOfPlayerEntitiesOnTheField();
+ if(players.length!==1)return;
+ for(const character of f.getAllCharacterEntitiesOfSpecifiedPlayer(players[0])){
+  if(evt.params.seq>f.getCustomVariable(character,'LAB_camera_seq').asType('int')){
+   f.setCustomVariable(character,'LAB_camera_seq',evt.params.seq,true);
+   f.castSkillFromSpecifiedPanelSlot(character as any,CharacterSkillSlot.Skill2Q,false);
+  }
+ }
+ })
+ .onSignal(SAMPLE,(evt,f)=>{
+ if(evt.params.point<0n||evt.params.point>3n)return;
+ if(evt.params.seq!==f.getCustomVariable(f.getSelfEntity(),'LAB_camera_seq').asType('int'))return;
+ const players=f.getListOfPlayerEntitiesOnTheField();
+ if(players.length!==1)return;
+ f.sendSignal(CAMERA,players[0],evt.params.seq,evt.params.point,evt.params.x,evt.params.y,evt.params.z);
+ })`;
+ return [{graphId:server.graphId,code},{graphId:skill.graphId,code:client}];
+}
+
+export async function prepareCameraProjection({call,mapPath}={}){
+ if(typeof call!=='function'||!mapPath)throw Error('Camera projection requires call and a base GIL');
+ const input=resolve(mapPath),original=readFileSync(input),workspace=join(dirname(input),`camera-projection-${randomUUID()}`);
+ mkdirSync(workspace);let current=join(workspace,'base.gil');copyFileSync(input,current,constants.COPYFILE_EXCL);
+ const hash=b=>createHash('sha256').update(b).digest('hex');
+ const receipt={sourcePath:input,inputSha256:hash(original),liveWriteEnabled:false,calls:[],statuses:{compile:'not_run',officialImport:'not_run',playtest:'not_run'}};
+ async function invoke(name,args={}){
+  const result=await call(name,{...args,mapPath:current});
+  writeFileSync(join(workspace,`${receipt.calls.length+1}-${name}.json`),JSON.stringify(result,null,2));
+  if(result.error||result.isError)throw Error(`${name}: ${JSON.stringify(result)}`);
+  if(result.mapPath){if(resolve(result.mapPath)===input)throw Error('Projection tool returned original input');current=result.mapPath;}
+  receipt.calls.push({name,mapPath:current});return result;
+ }
+ try{
+  for(const [name,parameters] of [['LAB3D_CAMERA_REQUEST',[{name:'seq',type:'integer'}]],['LAB3D_CAMERA_SAMPLE',payload],['LAB3D_CAMERA',payload]])await invoke('scene_add_signal',{name,parameters});
+  const server=await invoke('scene_add_graph',{name:'LAB3D_camera_projection',kind:'server',attachToPrefab:'character'});
+  const skill=await invoke('scene_add_graph',{name:'LAB3D_camera_projection_skill',kind:'characterSkill'});
+  await invoke('scene_add_components',{prefab:'character',variables:[{name:'LAB_camera_seq',type:'integer',value:0}]});
+  const configured=await invoke('scene_add_skill',{name:'ABYSS_camera_projection',type:'instant',graphId:skill.graphId});
+  const sources=cameraProjectionSources({server,skill,skillId:configured.skillId});
+  for(const s of sources)writeFileSync(join(workspace,`${s.graphId}.ts`),s.code);
+  const compiled=await invoke('write_graphs',{graphs:sources});
+  if(compiled.failed||compiled.errors?.length||compiled.written?.length!==sources.length)throw Error('Camera projection compilation incomplete');
+  const compiledBudget=assertCompiledBudget(compiled.written);
+  const inspected=await invoke('inspect_map'),graphBudget=assertGraphBudget(inspected.graphs);
+  if(!sources.every(s=>inspected.graphs.some(g=>g.id===s.graphId&&g.nodeCount>0)))throw Error('Camera projection readback incomplete');
+  if(!readFileSync(input).equals(original))throw Error('Camera projection source GIL changed');
+  const final=join(workspace,'camera-projection.gil');copyFileSync(current,final,constants.COPYFILE_EXCL);
+  Object.assign(receipt,{mapPath:final,outputSha256:hash(readFileSync(final)),graphs:{server,skill},sources,skillId:configured.skillId,compiledBudget,graphBudget});
+  receipt.statuses.compile='passed';return receipt;
+ }finally{writeFileSync(join(workspace,'camera-projection.json'),JSON.stringify(receipt,null,2));}
+}
diff --git a/scripts/native-3d/camera-projection.test.mjs b/scripts/native-3d/camera-projection.test.mjs
