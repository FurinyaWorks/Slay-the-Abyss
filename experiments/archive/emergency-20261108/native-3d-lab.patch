+        models={{name='守卫',hit=true},{name='史莱姆',hit=false},{name='丘丘人',hit=false}}},
+    clickEvent='click',send=function(command,model,actor,seq)requests[#requests+1]={command=command,seq=seq,actor=actor}end,
