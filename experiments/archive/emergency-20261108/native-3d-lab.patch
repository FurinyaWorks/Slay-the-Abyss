+local Sample=dofile('experiments/native-3d-lab/assets/runtime.lua')
+local function node(children,was)
+ local c={children=children or {},visible=was~=false,alive=true}
+ function c:GetChild(name)return self.children[name]end
+ function c:SetVisible(value)assert(self.alive);self.visible=value end
+ return c
+end
+local hp,card,original,previouslyHidden,sample=node(),node(),node(),node(nil,false),node(nil,false)
+local stage=node({labMaterialBackdrop=sample,officialBackground=original,officialBattleBackdrop=previouslyHidden,
+ battlePanel=node({hp=hp,card1=card,backdrop=node()}),menuPanel=node({backdrop=node(nil,false)})})
+local root=node({stage=stage})
+assert(Sample.toggle(root,true):find('107134',1,true));assert(sample.visible and not original.visible)
+assert(hp.visible and card.visible,'all battle HUD and card controls must survive')
+Sample.toggle(root,true);Sample.toggle(root,false)
+assert(not sample.visible and original.visible and not previouslyHidden.visible)
+assert(not stage:GetChild('menuPanel'):GetChild('backdrop').visible,'original false state must restore as false')
+Sample.toggle(root,false);Sample.toggle(root,true);Sample.destroy(root)
+assert(not sample.visible and original.visible and hp.visible and card.visible)
+print('material specimen: idempotent toggle, exact background visibility restore and HUD preservation passed')
diff --git a/experiments/native-3d-lab/build.mjs b/experiments/native-3d-lab/build.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..613eb373094812daf217bac4f9a9bcb1871626f4
--- /dev/null
+++ b/experiments/native-3d-lab/build.mjs
@@ -0,0 +1,136 @@
+import {readFileSync,writeFileSync,mkdirSync,copyFileSync,readdirSync} from 'node:fs';
+import {resolve,join,dirname} from 'node:path';
+import {pathToFileURL,fileURLToPath} from 'node:url';
+import {randomUUID} from 'node:crypto';
+import {execFileSync} from 'node:child_process';
+import {connect,data} from './rpc.mjs';
+import {labControls} from './layout.mjs';
+import {prepareNativeScene,labAnchor,validateLabAnchor} from './native-scene.mjs';
+import {instrumentCardTween} from './card-tween.mjs';
+import {fileRecord,sha256,writeExclusive,prepareOutputDirectory} from '../../scripts/evidence-files.mjs';
+import {writeScriptBatch} from '../../scripts/native-script-batch.mjs';
+import {embeddedScripts} from '../../scripts/native-script-inventory.mjs';
+import {runNativeClientCheck} from '../../scripts/native-client-check.mjs';
+import {assertNativeUiCapacity} from '../../scripts/build-ui.mjs';
+import {uiEquivalent} from './ui-readback.mjs';
+import {toLua} from '../../scripts/build-lua-data.mjs';
+const here=dirname(fileURLToPath(import.meta.url));
+const toolRoot=process.env.MILIASTRA_MCP_ROOT||'D:/MiliastraTools/genshin-miliastra-mcp';
+const toolModule=name=>import(pathToFileURL(join(toolRoot,'src',name)));
+
+function once(source,needle,replacement){
+  if(source.split(needle).length!==2)throw Error('Entry integration anchor changed: '+needle);
+  return source.replace(needle,replacement);
+}
+export function instrumentEntry(source,buildId){
+  if(!/^[a-f0-9-]{36}$/.test(buildId))throw Error('Invalid experiment build ID');
+  let text=source.replace(/\r\n/g,'\n').replace(/^print\("ABYSS_BUILD [a-f0-9-]+"\)\n/,'');
+  text=once(text,'local view, Viewport, background, cardArt, portraits','local lab\nlocal view, Viewport, background, cardArt, portraits');
+  text=once(text,'        view:resize(width, height)\n        canvasWidth, canvasHeight = width, height',`        view:resize(width, height)
+        lab = require('abyss_3d_lab').attach(view, script.object, {
+            send = function(command, model, actor, sequence)
+                local signal = game.ServerSignal('LAB3D_COMMAND')
+                signal:AddString(command)
+                signal:AddInt(model)
+                signal:AddInt(actor)
+                signal:AddInt(sequence)
+                signal:SendSignal()
+            end,
+            register = function(callback)
+                script:RegisterServerSignalHandler('LAB3D_ACK', function(_, params)
+                    callback(params[1], params[2])
+                end)
+            end,
+        })
+        canvasWidth, canvasHeight = width, height`);
+  text=once(text,'        view:update(dt)',`        view:update(dt)
+        if lab then
+            local updated, why = pcall(lab.update, lab, dt)
+            if not updated then lab.log('ERROR update '..tostring(why)) end
+        end`);
+  text=once(text,'function OnDestroy()','function OnDestroy()\n    if lab then pcall(function()lab:destroy()end);lab=nil end');
+  return `print("ABYSS_BUILD ${buildId}")\nprint("ABYSS_3D_LAB ${buildId}")\n${text}`;
+}
+export async function buildLab({productionReceipt,output='.artifacts/native-3d-lab',anchor=labAnchor}={}){
+  validateLabAnchor(anchor);
+  const root=resolve(here,'../..');
+  const original=JSON.parse(readFileSync(productionReceipt,'utf8'));
+  if(original.statuses?.staticCheck!=='pass'||fileRecord(original.mapPath).sha256!==original.candidate.sha256)
+    throw Error('Production source candidate is missing, changed or unchecked');
+  const buildId=randomUUID(),workspace=join(prepareOutputDirectory(root,output),buildId);
+  mkdirSync(workspace,{recursive:true});
+  let mapPath=join(workspace,'base.gil');copyFileSync(original.mapPath,mapPath);
+  const inputNames=readdirSync(here).filter(n=>/\.(lua|mjs)$/.test(n));
+  const inputs=[...inputNames.map(n=>fileRecord(join(here,n))),
+    ...['native-candidate-audit.mjs','native-script-batch.mjs','native-client-check.mjs','native-script-inventory.mjs','build-ui.mjs','evidence-files.mjs']
+      .map(n=>fileRecord(join(root,'scripts',n)))];
+  const receipt={schemaVersion:1,kind:'isolated-native-3d-experiment',task:'TASK-102',buildId,
+    startedAt:new Date().toISOString(),sourceCommit:execFileSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8',windowsHide:true}).trim(),
+    sourceDirty:Boolean(execFileSync('git',['status','--porcelain'],{cwd:root,encoding:'utf8',windowsHide:true}).trim()),
+    productionSourceCommit:original.sourceCommit,productionReceipt:fileRecord(productionReceipt),
+    productionCandidate:original.candidate,inputs,liveWriteEnabled:false,operations:[],
+    statuses:{staticCheck:'not_run',officialImport:'not_run',runtimeReady:'not_run',visualAnimations:'not_run',mobile:'not_run'}};
+  const client=await connect(workspace);
+  const {container,fields,field,one,replace,wrap}=await toolModule('scene/wire.mjs');
+  const {clientScriptRecord,addClientUi,getClientUi}=await toolModule('scene-save.mjs');
+  const {luaSyntaxError}=await toolModule('client-check.mjs');
+  const wire={container,fields,field,one,replace,wrap};
+  let sequence=0;
+  async function call(name,args={}){
+    const request={name,arguments:{mapPath,...args}};
+    const result=await client.callTool(request,undefined,{timeout:120000});
+    const record=join(workspace,`${++sequence}-${name}.json`);writeExclusive(record,result);
+    const value=data(result);if(value.error)throw Error(name+': '+JSON.stringify(value.error));
+    receipt.operations.push({name,response:fileRecord(record)});
+    if(value.mapPath)mapPath=value.mapPath;
+    return value;
+  }
+  try{
+    for(const uri of ['miliastra://workflow','miliastra://platform-rules'])writeExclusive(join(workspace,uri.split('//')[1]+'.json'),await client.readResource({uri}));
+    const native=await prepareNativeScene({call,mapPath,anchor});
+    if(native.mapPath)mapPath=native.mapPath;
+    receipt.nativeScene=native;
+    const layout=JSON.parse(readFileSync(original.productionManifest?.layout?.path||join(dirname(productionReceipt),'generated/game-ui.json'),'utf8'));
+    const stage=layout.controls.find(n=>n.name==='stage');
+    if(!stage||stage.children.some(n=>n.name==='labPanel'))throw Error('Expected fresh production stage');
+    stage.children.push(labControls());assertNativeUiCapacity(layout);
+    writeExclusive(join(workspace,'game-ui.json'),layout);
+    const before=embeddedScripts({mapPath,includeSource:true},wire).scripts;
+    const entry=before.find(n=>n.name==='abyss_ui');if(!entry)throw Error('Missing production entry');
+    const config={buildId,nativeAvailable:native.available!==false,reason:native.reason||'',
+      models:native.capabilities?.models||[{name:'遗迹守卫',hit:true},{name:'大型风史莱姆',hit:false},{name:'打手丘丘人',hit:false}],
+      deathClip:false,playerAnimation:false,maxActors:native.capabilities?.actors||3};
+    const cardView=before.find(n=>n.name==='abyss_battle_card_view');if(!cardView)throw Error('Missing production card view');
+    const updates=[{name:'abyss_ui',source:instrumentEntry(entry.source,buildId)},
+      {name:'abyss_3d_lab',source:readFileSync(join(here,'runtime.lua'),'utf8')},
+      {name:'abyss_3d_lab_config',source:'return '+toLua(config)+'\n'},
+      {name:'abyss_3d_card_tween',source:readFileSync(join(here,'card-tween.lua'),'utf8')},
+      {name:'abyss_battle_card_view',source:instrumentCardTween(cardView.source)}];
+    for(const update of updates)writeFileSync(join(workspace,update.name+'.lua'),update.source,{flag:'wx'});
+    mapPath=writeScriptBatch(mapPath,updates,workspace,{...wire,clientScriptRecord,luaSyntaxError});
+    const ui=addClientUi({...layout,mapPath,replace:true,outputName:'native-3d-lab'},workspace);
+    if(!ui.mapPath)throw Error('UI encoder returned no candidate');mapPath=ui.mapPath;
+    receipt.uiWrite=ui;
+    const checked=runNativeClientCheck({mapPath},toolRoot);writeExclusive(join(workspace,'client-check.json'),checked);
+    if(checked.ok!==true||checked.errors!==0)throw Error('Native client script check failed; inspect client-check.json');
+    receipt.clientCheck={checked:checked.checked,warnings:checked.warnings,problems:checked.problems};
+    const actual=embeddedScripts({mapPath,includeSource:true},wire).scripts;
+    const expected=new Map(before.map(n=>[n.name,n.source]));for(const u of updates)expected.set(u.name,u.source);
+    if(actual.length!==expected.size||actual.some(n=>expected.get(n.name)!==n.source))throw Error('Final embedded script readback differs');
+    receipt.modules=actual.map(n=>({name:n.name,sha256:sha256(n.source),bytes:Buffer.byteLength(n.source)}));
+    receipt.payloadDigest=sha256(JSON.stringify({productionPayload:original.payloadDigest,inputs,modules:receipt.modules,nativeConfig:config}));
+    const uiRead=getClientUi({mapPath,ui:layout.name});writeExclusive(join(workspace,'ui-readback.json'),uiRead);
+    if(!uiEquivalent(layout,uiRead.interface))throw Error('Final UI readback differs; inspect ui-readback.json');
+    receipt.uiReadbackKeys=Object.keys(uiRead);
+    for(const input of inputs)if(fileRecord(input.path).sha256!==input.sha256)throw Error('Experiment input changed during build');
+    const finalMap=join(workspace,'native-3d-lab.gil');copyFileSync(mapPath,finalMap);
+    receipt.mapPath=finalMap;receipt.candidate=fileRecord(finalMap);receipt.statuses.staticCheck='pass';
+    receipt.completedAt=new Date().toISOString();writeExclusive(join(workspace,'experiment.json'),receipt);
+    return receipt;
+  }catch(error){receipt.error=error.message;writeExclusive(join(workspace,'failure.json'),receipt);throw error}
+  finally{await client.close()}
+}
+if(process.argv[1]&&import.meta.url===pathToFileURL(resolve(process.argv[1])).href){
+  try{const r=await buildLab({productionReceipt:process.argv[2],...(process.argv[3]?{output:process.argv[3]}:{})});console.log(JSON.stringify({mapPath:r.mapPath,sha256:r.candidate.sha256,statuses:r.statuses}));}
+  catch(e){console.error(e.stack);process.exitCode=1}
+}
diff --git a/experiments/native-3d-lab/card-tween.lua b/experiments/native-3d-lab/card-tween.lua
new file mode 100644
index 0000000000000000000000000000000000000000..4b560cd4c12d98f92da3fd8c33c368f6e9c46f3e
--- /dev/null
+++ b/experiments/native-3d-lab/card-tween.lua
@@ -0,0 +1,166 @@
+-- One real hand card, x only. The experiment owns no game state or hitbox math.
+local M={}
+local owners=setmetatable({},{__mode='k'})
+local boxOwners=setmetatable({},{__mode='k'})
+local function resolve(view)return view and (view.battleUI or view)end
+local function clock()return os and os.clock and os.clock() or 0 end
+local function finite(v)return type(v)=='number' and v==v and math.abs(v)<math.huge end
+local function stats(samples)
+    if #samples==0 then return 0,0 end
+    local values,total={},0
+    for i,v in ipairs(samples)do values[i]=v;total=total+v end
+    table.sort(values)
+    return total/#samples*1000,values[math.max(1,math.ceil(#values*.95))]*1000
+end
+local function targetCopy(entry)
+    local t=entry.target
+    return {x=t.x,y=t.y,scale=t.scale,angle=t.angle,restAngle=t.restAngle,baseY=t.baseY}
+end
+local function sameTarget(entry,target)
+    if not entry.target then return false end
+    for key,value in pairs(target)do if entry.target[key]~=value then return false end end
+    return true
+end
+local function invalidContext(self,active,held)
+    local view,entry=self.view,active.entry
+    if view.active==false or entry.box.alive==false or (view.root and view.root.alive==false)then return 'destroy_or_disable' end
+    if view.canvasWidth~=active.width or view.canvasHeight~=active.height or view.run~=active.run
+        or not view.run or view.run.combat~=active.battle or view.run.phase~=active.phase then return 'battle_or_resize' end
+    if held or view.gesture or view.carry then return 'drag' end
+    if not sameTarget(entry,active.target)then return 'new_target' end
+end
+local function currentX(active)
+    active.reads=active.reads+1
+    local ok,x=pcall(function()return active.entry.box.anchoredPositionX end)
+    if ok and finite(x)then active.entry.current.x=x;return true end
+    return false
+end
+local function finish(self,reason,complete)
+    local active=self.active;if not active then return end
+    if complete then
+        local invalid=invalidContext(self,active)
+        if invalid then reason,complete=invalid,false end
+    end
+    if not complete then active.valid=false end
+    if complete and active.mode=='tween' then
+        active.entry.current.x=active.target.x
+        local ok=pcall(self.provider.paint,active.entry)
+        if not ok then reason='error:completion_paint';active.valid=false;complete=false end
+    end
+    self.active=nil;boxOwners[active.entry.box]=nil
+    if active.tween and not complete then
+        active.setupCalls=active.setupCalls+1
+        local ok=pcall(active.tween.Kill,active.tween,false)
+        if not ok then reason='error:Kill';active.valid=false end
+        currentX(active)
+    end
+    if complete then active.entry.current.x=active.target.x end
+    local mean,p95=stats(active.samples)
+    active.meanUpdateMs,active.p95UpdateMs=mean,p95
+    active.reason,active.completed=reason,complete==true
+    self.last=active
+    if complete and active.valid then self.results[active.mode]=active end
+end
+function M.recordPaint(box)
+    local owner=boxOwners[box]
+    if owner and owner.active then owner.active.setterWrites=owner.active.setterWrites+7 end
+end
+function M.attach(view,provider)
+    local previous=owners[view];if previous then previous:cancel('rebind')end
+    local self={view=view,provider=provider,results={}}
+    function self:cancel(reason)finish(self,reason or 'stop',false)end
+    function self:removed(entry)if self.active and self.active.entry==entry then self:cancel('removed')end end
+    function self:holdRender(entry,box,count,index,hot)
+        local a=self.active;if not a or a.entry~=entry then return false end
+        local invalid=invalidContext(self,a)
+        if invalid then self:cancel(invalid);return false end
+        local layout=entry.labLayout or {}
+        if box~=entry.box or layout.count~=count or layout.index~=index or layout.hot~=hot or not sameTarget(entry,a.target)then self:cancel('new_target');return false end
+        if a.mode=='tween' and not currentX(a)then self:cancel('error:position_read');return false end
+        return true
+    end
+    function self:before(entry,dt,held)
+        local a=self.active;if not a or a.entry~=entry then return false end
+        a.driveStart=clock()
+        local invalid=invalidContext(self,a,held)
+        if invalid then self:cancel(invalid);return false end
+        a.frames=a.frames+1;a.seconds=a.seconds+dt;a.samples[#a.samples+1]=dt
+        if a.mode=='tween' then
+            if not currentX(a)then self:cancel('error:position_read');return false end
+            if a.seconds>1.5 then self:cancel('error:Tween_timeout');return false end
+            return true
+        end
+        return false
+    end
+    function self:after(entry)
+        local a=self.active;if not a or a.entry~=entry then return end
+        a.driveCpuMs=a.driveCpuMs+(clock()-(a.driveStart or clock()))*1000
+        if a.mode=='manual' and math.abs(entry.current.x-a.target.x)<.001 then finish(self,'completed:manual',true)end
+    end
+    owners[view]=self
+    return self
+end
+function M.start(view,mode)
+    local owner=owners[resolve(view)]
+    if not owner then return false,'不可用：真实手牌视图尚未建立' end
+    owner:cancel('restart')
+    if mode~='manual' and mode~='tween' then return false,'未知Tween对比模式' end
+    local v=owner.view
+    if not v.run or not v.run.combat or v.gesture or v.carry or v.busy or v.active==false then return false,'请等待玩家回合，停止拖牌后重试' end
+    if mode=='tween' and (not game or type(game.Tween)~='function')then return false,'不可用：客户端缺少官方game.Tween' end
+    local selected
+    for _,entry in pairs(owner.provider.entries())do
+        if entry.visible and entry.box and entry.box.alive~=false and entry.target and entry.labLayout then
+            local settled=true
+            for _,key in ipairs({'x','y','scale','angle'})do if math.abs(entry.current[key]-entry.target[key])>.001 then settled=false end end
+            if settled and (not selected or tostring(entry.labUid)<tostring(selected.labUid))then selected=entry end
+        end
+    end
+    if not selected then return false,'请先进入战斗并等待真实手牌归位' end
+    if owner.last and (owner.last.battle~=v.run.combat or owner.last.entry.labUid~=selected.labUid)then owner.results={}end
+    local active={entry=selected,mode=mode,target=targetCopy(selected),run=v.run,battle=v.run.combat,phase=v.run.phase,width=v.canvasWidth,height=v.canvasHeight,
+        setterWrites=0,setupCalls=0,reads=0,driveCpuMs=0,frames=0,seconds=0,samples={},valid=true}
+    owner.active=active;boxOwners[selected.box]=owner
+    selected.current.x=selected.target.x+72
+    local ok,why=pcall(owner.provider.paint,selected)
+    if not ok then active.valid=false;finish(owner,'error:initial_paint',false);return false,tostring(why)end
+    if mode=='tween' then
+        local created,err=pcall(function()
+            active.setupCalls=active.setupCalls+1
+            active.tween=game.Tween(selected.box,{anchoredPositionX=selected.target.x},.24)
+            assert(active.tween and type(active.tween.Kill)=='function','Tween.Kill缺失')
+            active.setupCalls=active.setupCalls+1
+            active.tween:SetOnComplete(function()
+                if owner.active==active then finish(owner,'completed:tween',true)end
+            end)
+            active.setupCalls=active.setupCalls+1;active.tween:Play()
+        end)
+        if not created then active.valid=false;finish(owner,'error:Tween_create',false);return false,'官方Tween不可用：'..tostring(err)end
+    end
+    return true
+end
+function M.cancel(view,reason)local owner=owners[resolve(view)];if owner then owner:cancel(reason)end end
+function M.result(view)
+    local owner,result=owners[resolve(view)],{}
+    local a=owner and (owner.active or owner.last);if not a then return nil end
+    for _,key in ipairs({'mode','setterWrites','setupCalls','reads','driveCpuMs','frames','seconds','valid','reason','completed','meanUpdateMs','p95UpdateMs'})do result[key]=a[key]end
+    result.bridgeCalls=a.setterWrites+a.setupCalls+a.reads
+    result.cardUid=a.entry.labUid
+    result.sample='真实手牌横向+72归位；A保留原指数插值，B官方Tween0.24秒；时长曲线不同'
+    result.boundary='OnUpdate回调间隔/本实验Lua驱动耗时；非GPU帧时间或原生引擎成本'
+    result.comparisons={}
+    for mode,value in pairs(owner.results)do
+        result.comparisons[mode]={bridgeCalls=value.setterWrites+value.setupCalls+value.reads,
+            frames=value.frames,seconds=value.seconds,meanUpdateMs=value.meanUpdateMs,p95UpdateMs=value.p95UpdateMs,driveCpuMs=value.driveCpuMs}
+    end
+    return result
+end
+function M.status(view)
+    local r=M.result(view);if not r then return 'Tween对比：等待真实手牌；A原逐帧 / B官方0.24s' end
+    local owner=owners[resolve(view)];local a=owner.active or owner.last
+    local mean,p95=stats(a.samples)
+    local aResult,bResult=r.comparisons.manual,r.comparisons.tween
+    local comparison=aResult and bResult and string.format('；完成样本A%d/B%d次桥调用',aResult.bridgeCalls,bResult.bridgeCalls) or ''
+    return string.format('%s %s | Lua桥调用%d（写%d/读%d/控制%d）%s\nOnUpdate均值%.2f / P95 %.2f ms；Lua驱动%.3f ms\nA原曲线/B0.24s；非GPU数据，流畅度待实机',r.mode=='manual' and 'A原逐帧' or 'B官方Tween',r.reason or '运行中',r.bridgeCalls,r.setterWrites,r.reads,r.setupCalls,comparison,mean,p95,r.driveCpuMs)
+end
+return M
