new file mode 100644
index 0000000000000000000000000000000000000000..88d3ed15a86248f01026203d44dab830a6657d14
--- /dev/null
+++ b/experiments/native-3d-lab/shapes/probe.mjs
@@ -0,0 +1,42 @@
+import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
+import {join,resolve,dirname} from 'node:path';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+import {prepareShapeSample,shapeSample} from './hexaghost.mjs';
+import {shapeTools} from '../upstream-shapes.mjs';
+import {createHash} from 'node:crypto';
+const here=dirname(fileURLToPath(import.meta.url));
+const toolRoot=resolve(process.env.MILIASTRA_MCP_ROOT||'.artifacts/miliastra-upstream');
+const workspace=join(here,'.local');mkdirSync(workspace,{recursive:true});
+const sdk=join(toolRoot,'node_modules/@modelcontextprotocol/sdk/dist/esm/client');
+const {Client}=await import(pathToFileURL(join(sdk,'index.js'))),{StdioClientTransport}=await import(pathToFileURL(join(sdk,'stdio.js')));
+const client=new Client({name:'abyss-shape-probe',version:'1'});
+await client.connect(new StdioClientTransport({command:process.execPath,args:['D:/MiliastraTools/genshin-miliastra-mcp/src/server.mjs'],env:{...process.env,MILIASTRA_WORKSPACE:workspace,MILIASTRA_SAVE_ROOTS:JSON.stringify([resolve('.')]),MILIASTRA_ALLOW_LIVE_WRITE:'0'}}));
+const shapeAdapter=await shapeTools(workspace);
+let index=0;
+async function call(name,args){
+ console.log('SHAPE',name);
+ const raw=name==='scene_add_shape_prefab'||name==='scene_preview_shapes'?await shapeAdapter.call(name,args):await client.callTool({name,arguments:args},undefined,{timeout:120000});
+ writeFileSync(join(workspace,`${++index}-${name}.json`),JSON.stringify(raw,null,2));
+ if(raw.isError)throw Error(JSON.stringify(raw));
+ const value=raw.structuredContent??JSON.parse(raw.content.find(c=>c.type==='text').text);
+ if(value.error)throw Error(JSON.stringify(value));return value;
+}
+try{
+ for(const uri of ['miliastra://workflow','miliastra://platform-rules'])await client.readResource({uri});
+ const source=process.argv[2]||'.artifacts/native-3d-lab/85472c95-6d2f-421c-b16a-8e8b8dc1a4d2/native-3d-lab.gil';
+ const previews=await shapeAdapter.call('scene_preview_shapes',{parts:shapeSample.parts,views:['front','side','top','angle'],size:512});
+ if(previews.isError)throw Error(JSON.stringify(previews));
+ mkdirSync(join(here,'preview'),{recursive:true});
+ const views=previews.structuredContent.views,images=previews.content.filter(c=>c.type==='image');
+ for(const [i,image]of images.entries())writeFileSync(join(here,'preview',views[i]+'.png'),Buffer.from(image.data,'base64'));
+ const metadata={...previews.structuredContent,provenance:shapeAdapter.provenance,views:images.map((image,i)=>({view:views[i],sha256:createHash('sha256').update(Buffer.from(image.data,'base64')).digest('hex')}))};
+ writeFileSync(join(here,'preview/receipt.json'),JSON.stringify(metadata,null,2));
+ const result=await prepareShapeSample({mapPath:resolve(source),call});
+ const readbackPreviews=await shapeAdapter.call('scene_preview_shapes',{mapPath:result.mapPath,prefab:result.prefabId,views:['front','side','top','angle'],size:512});
+ if(readbackPreviews.isError)throw Error(JSON.stringify(readbackPreviews));
+ const finalImages=readbackPreviews.content.filter(c=>c.type==='image'),finalViews=readbackPreviews.structuredContent.views;
+ for(const [i,image]of finalImages.entries())writeFileSync(join(here,'preview',finalViews[i]+'.png'),Buffer.from(image.data,'base64'));
+ writeFileSync(join(here,'preview/receipt.json'),JSON.stringify({...readbackPreviews.structuredContent,provenance:shapeAdapter.provenance,source:'GIL prefab readback, not source-parts-only',views:finalImages.map((image,i)=>({view:finalViews[i],sha256:createHash('sha256').update(Buffer.from(image.data,'base64')).digest('hex')}))},null,2));
+ writeFileSync(join(workspace,'sample.json'),JSON.stringify(result,null,2));
+ console.log('SHAPE_DONE',JSON.stringify({mapPath:result.mapPath,inventory:result.inventory}));
+}finally{await client.close()}
diff --git a/experiments/native-3d-lab/tests/build.test.mjs b/experiments/native-3d-lab/tests/build.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9b2ea708ec38c4698a54adb113a1ca9dc9086ffe
--- /dev/null
+++ b/experiments/native-3d-lab/tests/build.test.mjs
@@ -0,0 +1,52 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import luaparse from 'luaparse';
+import {instrumentEntry} from '../build.mjs';
+import {labControls} from '../layout.mjs';
+import {assertNativeUiCapacity} from '../../../scripts/build-ui.mjs';
+import {equivalent,normalizeUi} from '../../../scripts/native-candidate-audit.mjs';
+import {uiEquivalent} from '../ui-readback.mjs';
+const id='12345678-1234-1234-1234-123456789abc';
+test('experimental entry keeps production startup and owns lab lifecycle plus typed bridge',()=>{
+  const source=readFileSync('src/lua/abyss_ui.lua','utf8');
+  const entry=instrumentEntry(source,id);
+  assert.doesNotThrow(()=>luaparse.parse(entry,{luaVersion:'5.3'}));
+  assert.equal(entry.match(/function OnStart\(/g).length,1);
+  assert.equal(entry.match(/function OnDestroy\(/g).length,1);
+  assert.match(entry,/signal:AddString\(command\)[\s\S]*signal:AddInt\(model\)[\s\S]*signal:AddInt\(actor\)[\s\S]*signal:AddInt\(sequence\)/);
+  assert.match(entry,/pcall\(lab.update, lab, dt\)/);
+  assert.match(entry,/ABYSS_BUILD 12345678-1234-1234-1234-123456789abc/);
+  assert.match(entry,/lab:destroy\(\)/);
+  assert.throws(()=>instrumentEntry(entry,id),/anchor changed/);
+  assert.throws(()=>instrumentEntry(source,'bad'),/Invalid/);
+});
+test('all experiment controls stay within native child/font capacity',()=>{
+  const controls=labControls();assertNativeUiCapacity({controls:[controls]});
+  const menu=controls.children.find(n=>n.name==='menu');
+  for(const name of ['compare','model','animations','combat','cards','performance','all','stop','reset'])
+    assert.ok(menu.children.some(n=>n.name===name),name);
+});
+test('native readback accepts codec quantization but rejects meaningful geometry and text changes',()=>{
+  const source=[{name:'sample',kind:'image',position:[1/3,2/3],size:[80,120],image:100001,opacity:.5}];
+  const actual=[{name:'sample',kind:'image',position:[.3333,.6667],size:[80,120],image:100001,opacity:128/255}];
+  assert.ok(equivalent(normalizeUi(source,'controls',true),normalizeUi(actual),'controls'));
+  actual[0].position[0]=.334;assert.equal(equivalent(normalizeUi(source,'controls',true),normalizeUi(actual),'controls'),false);
+  const a=[{name:'text',kind:'text',text:{content:'原生未验证'}}],b=[{name:'text',kind:'text',text:{content:'已验证'}}];
+  assert.equal(equivalent(normalizeUi(a,'controls',true),normalizeUi(b),'controls'),false);
+});
+test('native empty-container default does not excuse missing nonempty children or metadata',()=>{
+  const expected={name:'Lab',controls:[{name:'empty',kind:'container',children:[]}]};
+  const actual={name:'Lab',controls:[{name:'empty',kind:'container'}]};
+  assert.ok(uiEquivalent(expected,actual));
+  expected.controls[0].children.push({name:'required',kind:'text',text:{content:'HP'}});
+  assert.equal(uiEquivalent(expected,actual),false);
+  expected.controls[0].children=[];actual.blockKeys=true;
+  assert.equal(uiEquivalent(expected,actual),false);
+});
+test('native minimum font default is exactly 20, and every other minimum stays strict',()=>{
+  const actual={name:'Lab',controls:[{name:'label',kind:'text',text:{content:'HP'}}]};
+  const expected=structuredClone(actual);expected.controls[0].text.minFontSize=20;
+  assert.ok(uiEquivalent(expected,actual));
+  for(const size of [14,16,21]){expected.controls[0].text.minFontSize=size;assert.equal(uiEquivalent(expected,actual),false);}
+});
diff --git a/experiments/native-3d-lab/tests/card-tween.lua b/experiments/native-3d-lab/tests/card-tween.lua
new file mode 100644
index 0000000000000000000000000000000000000000..62b9462d277a6c66c4f19015c4cba364a66991d6
--- /dev/null
+++ b/experiments/native-3d-lab/tests/card-tween.lua
@@ -0,0 +1,92 @@
+local T=dofile('experiments/native-3d-lab/card-tween.lua')
+local function fixture()
+    local view={run={combat={}},active=true,canvasWidth=1600,canvasHeight=900}
+    local box={alive=true,anchoredPositionX=10}
+    local hit={x=3,y=4,width=110,height=220,angle=-9}
+    local entry={box=box,labUid=10,visible=true,labLayout={count=1,index=0,hot=false},
+        current={x=10,y=-100,scale=1.2,angle=9},target={x=10,y=-100,scale=1.2,angle=9,restAngle=9,baseY=-100}}
+    local paints=0
+    local controller=T.attach(view,{entries=function()return {[10]=entry}end,paint=function(e)
+        T.recordPaint(e.box);e.box.anchoredPositionX=e.current.x;paints=paints+1
+    end})
+    local tweens={}
+    game={Tween=function(object,values,duration)
+        local tween={object=object,values=values,duration=duration}
+        function tween:SetOnComplete(fn)self.callback=fn;return self end
+        function tween:Play()self.played=true;return self end
+        function tween:Kill(complete)self.killed=true;self.killComplete=complete end
+        tweens[#tweens+1]=tween;return tween
+    end}
+    return view,entry,controller,tweens,hit,function()return paints end
+end
+local function equal(a,b)assert(a==b,tostring(a)..' ~= '..tostring(b))end
+do
+    local view,e,c,tweens,hit,paints=fixture()
+    assert(T.start({battleUI=view},'tween'));equal(e.current.x,82);equal(tweens[1].values.anchoredPositionX,10)
+    equal(tweens[1].duration,.24);assert(tweens[1].played)
+    e.box.anchoredPositionX=46;assert(c:before(e,.12,nil));equal(e.current.x,46);c:after(e)
+    assert(c:holdRender(e,e.box,1,0,false));equal(paints(),1)
+    equal(e.current.y,-100);equal(e.current.scale,1.2);equal(e.current.angle,9)
+    equal(hit.x,3);equal(hit.y,4);equal(hit.width,110);equal(hit.height,220);equal(hit.angle,-9)
+    e.box.anchoredPositionX=10;tweens[1].callback();equal(e.current.x,10);equal(paints(),2)
+    local result=T.result(view);assert(result.completed);equal(result.setterWrites,14);equal(result.setupCalls,3)
+    assert(T.status(view):find('非GPU',1,true));equal(result.cardUid,10)
+end
+do
+    local view,e,c,tweens=fixture();assert(T.start(view,'tween'));e.box.anchoredPositionX=35
+    assert(not c:before(e,.016,{uid=10,moving=true}));assert(tweens[1].killed);equal(tweens[1].killComplete,false);equal(e.current.x,35)
+    local previous=e.current.x;tweens[1].callback();equal(e.current.x,previous);equal(T.result(view).reason,'drag')
+end
+do
+    local view,e,c,tweens=fixture();assert(T.start(view,'tween'));e.box.anchoredPositionX=29;e.target.x=15
+    assert(not c:holdRender(e,e.box,1,0,false));assert(tweens[1].killed);equal(e.current.x,29);equal(T.result(view).reason,'new_target')
+end
+for _,kind in ipairs({'resize','battle','destroy','stop','removed'})do
+    local view,e,c,tweens=fixture();assert(T.start(view,'tween'));e.box.anchoredPositionX=27
+    if kind=='resize'then view.canvasWidth=800;c:before(e,.016,nil)
+    elseif kind=='battle'then view.run={combat={}};c:before(e,.016,nil)
+    elseif kind=='destroy'then e.box.alive=false;c:before(e,.016,nil)
+    elseif kind=='removed'then c:removed(e)
+    else T.cancel(view,'stop')end
+    assert(tweens[1].killed,kind);equal(tweens[1].killComplete,false);equal(e.current.x,27)
+    assert(not T.result(view).completed)
+end
+-- Completion may arrive before the next CardView update/render. Every state
+-- snapshot must be checked at the callback boundary, before a target write.
+for _,kind in ipairs({'resize','battle','destroy','root_destroy','disabled','target','drag','phase'})do
+    local view,e,c,tweens,hit,paints=fixture()
+    assert(T.start(view,'tween'));e.box.anchoredPositionX=31
+    if kind=='resize'then view.canvasWidth=800
+    elseif kind=='battle'then view.run={combat={}}
+    elseif kind=='destroy'then e.box.alive=false
+    elseif kind=='root_destroy'then view.root={alive=false}
+    elseif kind=='disabled'then view.active=false
+    elseif kind=='target'then e.target.x=22
+    elseif kind=='drag'then view.gesture={uid=10,moving=true}
+    elseif kind=='phase'then view.run.phase='reward'end
+    tweens[1].callback()
+    equal(paints(),1);equal(e.current.x,31);assert(tweens[1].killed,kind);equal(tweens[1].killComplete,false)
+    local result=T.result(view)
+    assert(not result.completed,kind);assert(not result.valid,kind);assert(result.comparisons.tween==nil,kind)
+    assert(result.reason~='completed:tween',kind)
+end
+do
+    local view,e,c=fixture();game.Tween=nil
+    local ok,why=T.start(view,'tween');assert(not ok and why:find('缺少',1,true));equal(e.current.x,10)
+    assert(T.start(view,'manual'))
+    for _=1,100 do
+        local native=c:before(e,1/60,nil);assert(not native)
+        local x=e.current.x+(e.target.x-e.current.x)*.1
+        e.current.x=math.abs(x-e.target.x)<.667 and e.target.x or x
+        T.recordPaint(e.box);e.box.anchoredPositionX=e.current.x;c:after(e)
+        if T.result(view).completed then break end
+    end
+    local result=T.result(view);assert(result.completed);assert(result.setterWrites>100);equal(result.reads,0);equal(result.setupCalls,0)
+end
+do
+    local view,e,c,tweens=fixture()
+    game.Tween=function()error('injected failure')end
+    local ok,why=T.start(view,'tween');assert(not ok and why:find('不可用',1,true));assert(not c.active)
+    assert(not T.result(view).valid);assert(not c:before(e,.016,nil))
+end
+print('card tween: ownership, hitbox invariance, counters, drag/resize/battle/destroy/cancel/failure passed; mocked engine only')
